<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Account_OR_Lead_Required</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISBLANK(Account__c),
    ISBLANK(Lead__c)
)</errorConditionFormula>
    <errorMessage>Either Account or Lead must be selected</errorMessage>
</ValidationRule>
