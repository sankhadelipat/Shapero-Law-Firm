<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Document_Status</name>
        <label>Check Document Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Document_Sent</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.pandadoc__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>document.sent</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Related_Lead_Status_to_Retainer_Sent</targetReference>
            </connector>
            <label>Document Sent</label>
        </rules>
        <rules>
            <name>Document_Complete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.pandadoc__Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>document.completed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Related_Lead_Status_to_Retainer_Signed</targetReference>
            </connector>
            <label>Document Complete</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>PandadocDocument &gt; Update Lead Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PandadocDocument &gt; Update Lead Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Related_Lead_Status_to_Retainer_Sent</name>
        <label>Update Related Lead Status to Retainer Sent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Qualified</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.pandadoc__Lead__r</inputReference>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Related_Lead_Status_to_Retainer_Signed</name>
        <label>Update Related Lead Status to Retainer Signed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsConverted</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Retainer Signed</stringValue>
            </value>
        </inputAssignments>
        <inputReference>$Record.pandadoc__Lead__r</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Document_Status</targetReference>
        </connector>
        <filterLogic>1 AND 2 AND (3 OR 4)</filterLogic>
        <filters>
            <field>pandadoc__Lead__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>pandadoc__Status__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>pandadoc__Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>document.sent</stringValue>
            </value>
        </filters>
        <filters>
            <field>pandadoc__Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>document.completed</stringValue>
            </value>
        </filters>
        <object>pandadoc__PandaDocDocument__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
